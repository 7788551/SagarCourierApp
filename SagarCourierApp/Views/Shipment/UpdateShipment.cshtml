@{
    ViewData["Title"] = "Update Shipment";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var shipmentId = ViewContext.RouteData.Values["id"];
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">
            <h4>Update Shipment</h4>
        </div>

        <div class="card-body">

            <div id="message"></div>

            <form id="UpdateShipmentForm">

                <div class="mb-3">
                    <label class="form-label">Tracking Number</label>
                    <input type="text"
                           id="TrackingNumber"
                           class="form-control"
                           readonly />
                </div>

                <div class="mb-3">
                    <label class="form-label">Sender Name</label>
                    <input type="text"
                           id="SenderName"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Receiver Name</label>
                    <input type="text"
                           id="ReceiverName"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Receiver Phone</label>
                    <input type="text"
                           id="ReceiverPhone"
                           class="form-control"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Pickup Address</label>
                    <textarea id="PickupAddress"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Delivery Address</label>
                    <textarea id="DeliveryAddress"
                              class="form-control"
                              rows="3"
                              required></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Weight (KG)</label>
                    <input type="number"
                           id="Weight"
                           class="form-control"
                           min="0.01"
                           step="0.01"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Shipment Status</label>

                    <select id="Status" class="form-select" required>
                        <option value="Pending">Pending</option>
                        <option value="PickedUp">Picked Up</option>
                        <option value="InTransit">In Transit</option>
                        <option value="Delivered">Delivered</option>
                        <option value="Cancelled">Cancelled</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-primary">
                    Update Shipment
                </button>

                <a href="@Url.Action("GetShipments", "Shipment")"
                   class="btn btn-secondary">
                    Back
                </a>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>

        const apiUrl = '@Url.Content("~/api/ShipmentApi")';
        const shipmentId = Number('@shipmentId');

        $(document).ready(function() {

            GetShipmentById();

        });

        // Get shipment details by ID
        function GetShipmentById() {

            $.ajax({
                url: apiUrl + "/" + shipmentId,
                type: "GET",

                success: function(response) {

                    $("#TrackingNumber").val(response.trackingNumber);
                    $("#SenderName").val(response.senderName);
                    $("#ReceiverName").val(response.receiverName);
                    $("#ReceiverPhone").val(response.receiverPhone);
                    $("#PickupAddress").val(response.pickupAddress);
                    $("#DeliveryAddress").val(response.deliveryAddress);
                    $("#Weight").val(response.weight);
                    $("#Status").val(response.status);

                },

                error: function(xhr) {

                    let errorMessage = xhr.responseJSON?.message
                        || "Unable to load shipment.";

                    $("#message").html(`
                                <div class="alert alert-danger">
                                    ${errorMessage}
                                </div>
                            `);

                    $("#UpdateShipmentForm :input").prop("disabled", true);
                }
            });
        }

        // Update shipment
        $("#UpdateShipmentForm").submit(function(e) {

            e.preventDefault();

            var shipment = {
                senderName: $("#SenderName").val(),
                receiverName: $("#ReceiverName").val(),
                receiverPhone: $("#ReceiverPhone").val(),
                pickupAddress: $("#PickupAddress").val(),
                deliveryAddress: $("#DeliveryAddress").val(),
                weight: parseFloat($("#Weight").val()),
                status: $("#Status").val()
            };

            $.ajax({
                url: apiUrl + "/" + shipmentId,
                type: "PUT",
                contentType: "application/json",
                data: JSON.stringify(shipment),

                success: function(response) {

                    $("#message").html(`
                                <div class="alert alert-success">
                                    ${response.message}
                                </div>
                            `);

                    setTimeout(function() {
                        window.location.href =
                            '@Url.Action("GetShipments", "Shipment")';
                    }, 1500);
                },

                error: function(xhr) {

                    let errorMessage = xhr.responseJSON?.message
                        || "Unable to update shipment.";

                    $("#message").html(`
                                <div class="alert alert-danger">
                                    ${errorMessage}
                                </div>
                            `);
                }
            });
        });

    </script>
}
