@{
    ViewData["Title"] = "GetStaff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>All Staff Lists</h2>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>Staff ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="StaffTableBody"></tbody>

    </table>

</div>

@section Scripts {

    <script>

        $(document).ready(function() {
            loadUser();
        });

        // GET ALL STAFF
        function loadUser() {

            $.ajax({

                url: "/api/StaffApi",
                type: "GET",

                success: function(user) {

                    $("#StaffTableBody").empty();

                    $.each(user, function(index, item) {

                        var row = `
                                    <tr>
                                        <td>${item.userId}</td>
                                        <td>${item.fullName}</td>
                                        <td>${item.email}</td>
                                        <td>
                                            <a href="@Url.Action("UpdateStaff", "Staff")/${item.userId}"
                                               class="btn btn-primary btn-sm">
                                                Edit
                                            </a>

                                            <button class="btn btn-danger btn-sm"
                                                onclick="deleteUser(${item.userId})">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                `;

                        $("#StaffTableBody").append(row);

                    });

                },

                error: function(xhr) {

                    console.log(xhr.responseText);
                    alert("Unable to load staff details!");

                }

            });

        }

        // DELETE STAFF
        function deleteUser(id) {

            if (confirm("Are you sure you want to delete this staff member?")) {

                $.ajax({

                    url: "/api/StaffApi/" + id,
                    type: "DELETE",

                    success: function(response) {

                        alert("Staff deleted successfully!");

                        // Reload staff list after deletion
                        loadUser();

                    },

                    error: function(xhr) {

                        alert("Unable to delete staff!");

                        console.log(xhr.responseText);

                    }

                });

            }

        }

    </script>

}
