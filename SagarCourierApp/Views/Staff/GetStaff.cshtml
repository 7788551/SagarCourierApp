@{
    ViewData["Title"] = "Manage Staff";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">Manage Staff</h2>
            <p class="text-muted mb-0">
                View, update and manage registered staff members.
            </p>
        </div>

        <div>
            <a href="@Url.Action("AdminDashboard", "Dashboard")"
               class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left"></i>
                Back to Dashboard
            </a>

            <a href="@Url.Action("Register", "Account")"
               class="btn btn-success">
                <i class="bi bi-person-plus"></i>
                Add Staff
            </a>
        </div>

    </div>

    <!-- Staff Table -->
    <div class="card shadow-sm border-0">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Staff ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="StaffTableBody">
                        <tr>
                            <td colspan="4" class="text-center">
                                Loading staff details...
                            </td>
                        </tr>
                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function() {
            loadUser();
        });

        // GET ALL STAFF
        function loadUser() {

            $.ajax({

                url: "/api/StaffApi",
                type: "GET",

                success: function(user) {

                    $("#StaffTableBody").empty();

                    if (user.length === 0) {

                        $("#StaffTableBody").html(`
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            No staff members found.
                                        </td>
                                    </tr>
                                `);

                        return;
                    }

                    $.each(user, function(index, item) {

                        var row = `
                                    <tr>
                                        <td>${item.userId}</td>
                                        <td>${item.fullName}</td>
                                        <td>${item.email}</td>

                                        <td>
                                            <a href="@Url.Action("UpdateStaff", "Staff")/${item.userId}"
                                               class="btn btn-primary btn-sm">
                                                Edit
                                            </a>

                                            <button type="button"
                                                    class="btn btn-danger btn-sm"
                                                    onclick="deleteUser(${item.userId})">
                                                Delete
                                            </button>
                                        </td>
                                    </tr>
                                `;

                        $("#StaffTableBody").append(row);

                    });

                },

                error: function(xhr) {

                    console.log(xhr.responseText);

                    $("#StaffTableBody").html(`
                                <tr>
                                    <td colspan="4" class="text-center text-danger">
                                        Unable to load staff details.
                                    </td>
                                </tr>
                            `);

                }

            });

        }

        // DELETE STAFF
        function deleteUser(id) {

            if (confirm("Are you sure you want to delete this staff member?")) {

                $.ajax({

                    url: "/api/StaffApi/" + id,
                    type: "DELETE",

                    success: function(response) {

                        alert("Staff deleted successfully!");

                        // Reload staff list after deletion
                        loadUser();

                    },

                    error: function(xhr) {

                        alert("Unable to delete staff!");

                        console.log(xhr.responseText);

                    }

                });

            }

        }

    </script>

}
